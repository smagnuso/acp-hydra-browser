{
  "name": "acp-hydra-browser",
  "version": "0.1.0",
  "description": "Browser-based UI for acp-hydra sessions.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "acp-hydra-browser": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/copy-ui.mjs",
    "watch": "tsc -p . --watch",
    "start": "node dist/index.js",
    "dev": "tsc -p . && node scripts/copy-ui.mjs && node dist/index.js",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "lint": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}
